<script>
  /* =========================
     SITE MENU
  ========================= */

  const siteMenuButton = document.querySelector(".site-menu-button");
  const siteMenuPanel = document.querySelector(".site-menu-panel");
  const siteMenuClose = document.querySelector(".site-menu-close");
  const siteMenuLinks = document.querySelectorAll(".site-menu-nav a");


  /* =========================
     PAGE INDEX
  ========================= */

  const indexButton = document.querySelector(".page-index-button");
  const indexPanel = document.querySelector(".page-index-panel");
  const indexClose = document.querySelector(".page-index-close");
  const indexLinks = document.querySelectorAll(".page-index-nav a");


  /* =========================
     PAGE INDEX：OPEN / CLOSE
  ========================= */

  indexButton.addEventListener("click", () => {
    indexPanel.classList.add("is-open");
    siteMenuButton.classList.add("is-hidden");
  });

  indexClose.addEventListener("click", () => {
    indexPanel.classList.remove("is-open");
    siteMenuButton.classList.remove("is-hidden");
  });

  indexLinks.forEach(link => {
    link.addEventListener("click", () => {
      indexPanel.classList.remove("is-open");
      siteMenuButton.classList.remove("is-hidden");
    });
  });


  
  /* =========================
     SITE MENU：OPEN / CLOSE
  ========================= */

  siteMenuButton.addEventListener("click", () => {
    siteMenuPanel.classList.add("is-open");
    siteMenuButton.classList.add("is-hidden");
  });

  siteMenuClose.addEventListener("click", () => {
    siteMenuPanel.classList.remove("is-open");
    siteMenuButton.classList.remove("is-hidden");
  });

  siteMenuLinks.forEach(link => {
    link.addEventListener("click", () => {
      siteMenuPanel.classList.remove("is-open");
      siteMenuButton.classList.remove("is-hidden");
    });
  });

  siteMenuPanel.addEventListener("click", (event) => {
    if (event.target === siteMenuPanel) {
      siteMenuPanel.classList.remove("is-open");
      siteMenuButton.classList.remove("is-hidden");
    }
  });

</script>
  

